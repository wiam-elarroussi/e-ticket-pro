generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  VOUCHER
}

// Transaction de vente au guichet (local ou distant). Toutes les références
// vers les autres microservices (venue/events/tickets/auth) sont de simples
// UUID scalaires — même principe que partout ailleurs dans le projet. Une
// commande n'est persistée qu'une fois TOUTES ses lignes validées côté
// services externes (prix résolu, siège disponible, jauge non bloquée,
// billet généré) : pas d'état "brouillon" à nettoyer en cas d'échec partiel,
// voir OrdersService.checkout pour la logique de compensation.
model Order {
  id            String        @id @default(uuid()) @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  venueId       String        @map("venue_id") @db.Uuid
  channelId     String        @map("channel_id") @db.Uuid
  operatorId    String        @map("operator_id") @db.Uuid
  status        OrderStatus   @default(COMPLETED)
  paymentMethod PaymentMethod @map("payment_method")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)

  // Renseigné si au moins une ligne exige une identification nominative.
  buyerName  String? @map("buyer_name") @db.VarChar(150)
  buyerEmail String? @map("buyer_email") @db.VarChar(150)
  buyerPhone String? @map("buyer_phone") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([eventId])
  @@index([channelId])
  @@index([operatorId])
  @@map("orders")
}

// Une ligne = un siège vendu à une catégorie/tarif donnés. `unitPrice` fige
// le prix résolu au moment de la vente (la grille tarifaire peut changer
// ensuite sans affecter les ventes déjà enregistrées). `eventId`/`standId`/
// `zoneId` sont dupliqués depuis la commande/le siège (fournis par le
// frontend, qui connaît déjà ce contexte via la page zone/plan) pour que le
// contrôle des jauges de vente (module 3.4, portée Tribune/Zone) se fasse
// par un simple COUNT sur cette table, sans redemander l'ascendance du
// siège à venue-service à chaque vérification.
model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  eventId    String  @map("event_id") @db.Uuid
  seatId     String  @map("seat_id") @db.Uuid
  standId    String  @map("stand_id") @db.Uuid
  zoneId     String  @map("zone_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  ticketId   String? @map("ticket_id") @db.Uuid
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([seatId, orderId])
  @@index([eventId, standId])
  @@index([eventId, zoneId])
  @@map("order_items")
}
