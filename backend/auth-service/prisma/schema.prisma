generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionEffect {
  GRANT
  DENY
}

enum SalesChannelType {
  LOCAL_POS
  REMOTE_POS
  WEB
  PARTNER_API
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  label     String   @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  username            String    @unique @db.VarChar(50)
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(150)
  roleId              String    @map("role_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdById         String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  role             Role                 @relation(fields: [roleId], references: [id])
  createdBy        User?                @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers     User[]               @relation("UserCreatedBy")
  userPermissions  UserPermission[]
  sessions         Session[]
  revokedSessions  Session[]            @relation("SessionRevokedBy")
  passwordResets   PasswordResetToken[]
  auditLogs        AuditLog[]
  archivedPartners Partner[]

  @@map("users")
}

model UserPermission {
  userId       String           @map("user_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect @default(GRANT)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  salesChannelId   String?   @map("sales_channel_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceInfo       Json?     @map("device_info")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedById      String?   @map("revoked_by") @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])
  revokedBy    User?         @relation("SessionRevokedBy", fields: [revokedById], references: [id])

  @@map("sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Partner {
  id           String        @id @default(uuid()) @db.Uuid
  companyName  String        @map("company_name") @db.VarChar(150)
  contactName  String?       @map("contact_name") @db.VarChar(150)
  email        String?       @db.VarChar(255)
  phone        String?       @db.VarChar(30)
  apiKeyHash   String?       @map("api_key_hash") @db.VarChar(255)
  status       PartnerStatus @default(ACTIVE)
  // Soft delete : un partenaire archivé disparaît de la liste active mais
  // conserve son historique (quotas/ventes) pour la conformité des audits.
  archivedAt   DateTime?     @map("archived_at")
  archivedById String?       @map("archived_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  archivedBy    User?          @relation(fields: [archivedById], references: [id])
  salesChannels SalesChannel[]
  quotas        PartnerQuota[]

  @@map("partners")
}

model SalesChannel {
  id               String           @id @default(uuid()) @db.Uuid
  partnerId        String?          @map("partner_id") @db.Uuid
  name             String           @db.VarChar(150)
  type             SalesChannelType
  isActive         Boolean          @default(true) @map("is_active")
  salesWindowStart DateTime?        @map("sales_window_start") @db.Time()
  salesWindowEnd   DateTime?        @map("sales_window_end") @db.Time()
  createdAt        DateTime         @default(now()) @map("created_at")

  partner  Partner?       @relation(fields: [partnerId], references: [id])
  sessions Session[]
  quotas   PartnerQuota[]

  @@map("sales_channels")
}

model PartnerQuota {
  id               String    @id @default(uuid()) @db.Uuid
  partnerId        String    @map("partner_id") @db.Uuid
  salesChannelId   String?   @map("sales_channel_id") @db.Uuid
  eventId          String?   @map("event_id") @db.Uuid
  ticketCategoryId String?   @map("ticket_category_id") @db.Uuid
  maxQuantity      Int       @map("max_quantity")
  soldQuantity     Int       @default(0) @map("sold_quantity")
  periodStart      DateTime? @map("period_start")
  periodEnd        DateTime? @map("period_end")

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])

  @@map("partner_quotas")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String?  @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}
