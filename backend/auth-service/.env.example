# Base de données
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eticketpro_auth?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Access Token (RS256 - clé asymetrique, verifiable offline par les devices Edge / tourniquets)
# Generer avec scripts/generate-keys.sh puis encoder en base64 :
#   base64 -w0 keys/private.pem  ->  JWT_PRIVATE_KEY
#   base64 -w0 keys/public.pem   ->  JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# JWT Refresh Token (HS256 - secret symetrique, connu uniquement du auth-service)
JWT_REFRESH_SECRET=change_me_with_a_long_random_string

# JWT Refresh Token spectateurs (E-Ticket-Pay) - secret distinct de celui du staff
JWT_CUSTOMER_REFRESH_SECRET=change_me_with_a_different_long_random_string

PORT=3001
