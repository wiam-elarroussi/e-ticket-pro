# Ce microservice n'a pas de base de données propre : il agrège en lecture seule
# les données des autres services (aucune donnée n'est dupliquée ni stockée ici).

# Redis (partagé avec auth-service, uniquement pour vérifier la révocation de session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Doit être EXACTEMENT la même clé publique que auth-service (même paire RS256)
JWT_PUBLIC_KEY=

# Microservices agrégés pour les tableaux de bord, comparatifs et exports.
AUTH_SERVICE_URL=http://localhost:3001
EVENTS_SERVICE_URL=http://localhost:3002
VENUE_SERVICE_URL=http://localhost:3003
POS_SERVICE_URL=http://localhost:3004
TICKETS_SERVICE_URL=http://localhost:3005
ACCESS_SERVICE_URL=http://localhost:3007

PORT=3008
