# Base de données (dédiée à ce microservice, séparée des autres)
DATABASE_URL="postgresql://eticketpro:eticketpro_dev_pwd@localhost:5432/eticketpro_access?schema=public"

# Redis (partagé avec auth-service, uniquement pour vérifier la révocation de session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Doit être EXACTEMENT la même clé publique que auth-service (même paire RS256)
JWT_PUBLIC_KEY=

# Microservices consommés lors du scan (vérification billet, entrée abonné,
# contrôle d'accréditation gate/zone).
EVENTS_SERVICE_URL=http://localhost:3002
TICKETS_SERVICE_URL=http://localhost:3005
VENUE_SERVICE_URL=http://localhost:3003

PORT=3007
