generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanType {
  TICKET
  SUBSCRIPTION
}

enum ScanResult {
  VALID
  ALREADY_SCANNED
  INVALID
  CANCELLED
  WRONG_EVENT
  OVERRIDDEN
}

// Journal de chaque tentative de scan à une porte — c'est cette table qui
// permet de détecter un "déjà scanné" (rejouer un billet valide une seconde
// fois) et qui sert d'audit trail pour la supervision (module 7). Toutes
// les références externes (event/gate/ticket/subscription/opérateur) sont
// de simples UUID scalaires, même principe que le reste du projet.
model AccessLog {
  id         String     @id @default(uuid()) @db.Uuid
  eventId    String     @map("event_id") @db.Uuid
  gateId     String     @map("gate_id") @db.Uuid
  scanType   ScanType   @map("scan_type")
  ticketId   String?    @map("ticket_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid
  rawCode    String?    @map("raw_code") @db.VarChar(60)
  result     ScanResult
  reason     String?    @db.VarChar(255)
  scannedById String    @map("scanned_by") @db.Uuid
  scannedAt  DateTime   @default(now()) @map("scanned_at")

  @@index([eventId, ticketId])
  @@index([eventId, subscriptionId])
  @@index([gateId])
  @@map("access_logs")
}
