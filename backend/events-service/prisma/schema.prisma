generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  MATCH
  COMPETITION
  SHOW
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Pas de FK vers "venues" (autre microservice/base) : simple UUID scalaire,
// résolu côté frontend via venue-service pour l'affichage. Même principe que
// createdById dans venue-service vers auth-service.
model Event {
  id       String      @id @default(uuid()) @db.Uuid
  name     String      @db.VarChar(150)
  type     EventType
  homeTeam String?     @map("home_team") @db.VarChar(100)
  awayTeam String?     @map("away_team") @db.VarChar(100)
  venueId  String      @map("venue_id") @db.Uuid
  status   EventStatus @default(DRAFT)

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  // Fenêtre de vente : bornes optionnelles (null = pas de contrainte de ce côté).
  salesOpenAt  DateTime? @map("sales_open_at")
  salesCloseAt DateTime? @map("sales_close_at")

  // Limite panier ("max 3 billets par panier") : null = pas de limite.
  maxPerOrder Int? @map("max_per_order")

  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceRules              PriceRule[]
  subscriptionFormulaLink SubscriptionFormulaEvent[]
  salesQuotas             SalesQuota[]

  @@index([venueId])
  @@index([startAt])
  @@map("events")
}

// Catalogue réutilisable entre événements (Plein Tarif, Enfant, VIP, Presse,
// Gratuité/Invitation...) — indépendant du calendrier, configuré une fois.
model TicketCategory {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique @db.VarChar(30)
  name   String  @db.VarChar(100)
  isFree Boolean @default(false) @map("is_free")
  // Vente soumise à saisie acheteur (nom/prénom, pièce...) — le formulaire de
  // capture lui-même est porté par le module 5 (POS), ceci n'est que le
  // marqueur de configuration indiquant quelles catégories l'exigent.
  requiresNominativeInfo Boolean @default(false) @map("requires_nominative_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  priceRules  PriceRule[]
  salesQuotas SalesQuota[]

  @@map("ticket_categories")
}

enum PriceScope {
  EVENT
  STAND
  ZONE
  SEAT
}

// Grille tarifaire : prix d'une catégorie pour un événement, à la granularité
// choisie (tout l'événement, une tribune, une zone ou un siège individuel).
// La résolution du prix effectif retient la règle la plus spécifique
// (SEAT > ZONE > STAND > EVENT). `validFrom`/`validTo` permettent une
// variation par période (ex: tarif "early bird") : plusieurs règles peuvent
// coexister pour le même (event, catégorie, cible) sur des fenêtres disjointes.
model PriceRule {
  id         String     @id @default(uuid()) @db.Uuid
  eventId    String     @map("event_id") @db.Uuid
  categoryId String     @map("category_id") @db.Uuid
  scope      PriceScope @default(EVENT)

  // Renseigné selon `scope` uniquement (cross-service, simples UUID scalaires
  // vers venue-service — même principe que Event.venueId).
  standId String? @map("stand_id") @db.Uuid
  zoneId  String? @map("zone_id") @db.Uuid
  seatId  String? @map("seat_id") @db.Uuid

  price Decimal @db.Decimal(10, 2)

  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([eventId, categoryId])
  @@map("price_rules")
}

enum SubscriptionFormulaType {
  SAISON
  ELIMINATOIRES
  POULES
}

// Formule permanente (Saison, Éliminatoires, Poules...) : un prix forfaitaire
// donnant accès à un sous-ensemble d'événements de la même enceinte, défini
// via SubscriptionFormulaEvent. Distincte des cartes abonnés (Subscription)
// qui sont les instances effectivement vendues à un titulaire.
model SubscriptionFormula {
  id      String                  @id @default(uuid()) @db.Uuid
  name    String                  @db.VarChar(150)
  type    SubscriptionFormulaType
  venueId String                  @map("venue_id") @db.Uuid
  price   Decimal                 @db.Decimal(10, 2)

  validFrom DateTime @map("valid_from")
  validTo   DateTime @map("valid_to")

  // Accès global : la formule donne accès à TOUS les événements de l'enceinte (indépendamment du
  // calendrier inclus ci-dessous) — cas courant d'un abonnement "saison" plutôt qu'un abonnement
  // ciblé (éliminatoires/poules) où seul un sous-ensemble d'événements doit être couvert.
  globalAccess Boolean @default(false) @map("global_access")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  includedEvents SubscriptionFormulaEvent[]
  subscriptions  Subscription[]

  @@index([venueId])
  @@map("subscription_formulas")
}

// Table de liaison : quels événements sont couverts par une formule.
// Modifiable indépendamment (le calendrier d'une saison se complète au fil
// du temps) via un endpoint dédié plutôt qu'en réécrivant la formule entière.
model SubscriptionFormulaEvent {
  formulaId String @map("formula_id") @db.Uuid
  eventId   String @map("event_id") @db.Uuid

  formula SubscriptionFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  event   Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([formulaId, eventId])
  @@map("subscription_formula_events")
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Carte abonné effectivement émise pour un titulaire, rattachée à une
// formule. `seatId` optionnel : place nominative fixe pour toute la saison
// (sinon l'abonné valide simplement sa présence événement par événement).
model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  formulaId   String             @map("formula_id") @db.Uuid
  holderName  String             @map("holder_name") @db.VarChar(150)
  holderEmail String?            @map("holder_email") @db.VarChar(150)
  holderPhone String?            @map("holder_phone") @db.VarChar(30)
  seatId      String?            @map("seat_id") @db.Uuid
  // UID de la carte physique (badge NFC/RFID), enregistré au guichet via un
  // lecteur USB — même principe que GeneratedTicket.nfcTagId côté billets.
  nfcTagId    String?            @unique @map("nfc_tag_id") @db.VarChar(100)
  status      SubscriptionStatus @default(ACTIVE)

  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  formula SubscriptionFormula @relation(fields: [formulaId], references: [id], onDelete: Restrict)

  @@index([formulaId])
  @@map("subscriptions")
}

enum QuotaScope {
  EVENT
  STAND
  ZONE
  CHANNEL
}

// Jauge de vente : plafond de billets pour un événement, à la granularité
// choisie (tout l'événement, une tribune, une zone ou un canal de vente/guichet),
// optionnellement croisée avec une catégorie de billet. `isBlocked` permet en
// plus un blocage/déblocage instantané indépendant du plafond chiffré — même
// principe que SalesChannel.isActive dans auth-service (droit `quotas:toggle`
// distinct de `quotas:manage`, pour une action d'urgence sans droit de
// configuration complet).
model SalesQuota {
  id     String     @id @default(uuid()) @db.Uuid
  eventId String    @map("event_id") @db.Uuid
  scope  QuotaScope @default(EVENT)

  // Renseigné selon `scope` uniquement (cross-service, simples UUID scalaires).
  standId   String? @map("stand_id") @db.Uuid
  zoneId    String? @map("zone_id") @db.Uuid
  channelId String? @map("channel_id") @db.Uuid

  // Restriction croisée optionnelle par catégorie de billet (ex: bloquer
  // uniquement les places VIP d'une tribune, pas toute la tribune).
  categoryId String? @map("category_id") @db.Uuid

  maxQuantity Int?    @map("max_quantity")
  isBlocked   Boolean @default(false) @map("is_blocked")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("sales_quotas")
}
