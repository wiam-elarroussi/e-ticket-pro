# Base de données (dédiée à ce microservice, séparée des autres)
DATABASE_URL="postgresql://eticketpro:eticketpro_dev_pwd@localhost:5432/eticketpro_events?schema=public"

# Redis (partagé avec auth-service, uniquement pour vérifier la révocation de session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Doit être EXACTEMENT la même clé publique que auth-service (même paire RS256) :
# copier la valeur JWT_PUBLIC_KEY depuis backend/auth-service/.env
JWT_PUBLIC_KEY=

PORT=3002
